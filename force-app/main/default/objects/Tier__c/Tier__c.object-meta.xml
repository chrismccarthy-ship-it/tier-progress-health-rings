<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>A tier progression record: one Account&apos;s journey from its current tier to the next one. Child Tier_List_Item__c records are the weighted requirements that make up the completion percentage rendered by the tierProgressRing LWC.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Tier</label>
    <nameField>
        <label>Tier Progress Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Tiers</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <listViews>
        <fullName>All_Tiers</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Current_Tier__c</columns>
        <columns>Next_Tier__c</columns>
        <columns>Progress_Percent__c</columns>
        <columns>Items_Outstanding__c</columns>
        <columns>Status__c</columns>
        <columns>Target_Date__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Tiers</label>
    </listViews>
    <listViews>
        <fullName>In_Progress</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Next_Tier__c</columns>
        <columns>Progress_Percent__c</columns>
        <columns>Items_Outstanding__c</columns>
        <columns>Target_Date__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>In Progress</value>
        </filters>
        <label>In Progress</label>
    </listViews>
</CustomObject>
